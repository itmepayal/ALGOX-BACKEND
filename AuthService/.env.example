# AuthService environment (example — copy to .env and fill values)
# Never commit real secrets.

PORT=3001
MONGO_URL=mongodb://localhost:27017/algopath
REDIS_URL=
REDIS_TOKEN=
PROBLEM_SERVICE=http://localhost:3002
SUBMISSION_SERVICE=http://localhost:3003
JWT_SECRET=
REFRESH_TOKEN_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
INTERNAL_SERVICE_SECRET=
RESEND_API_KEY=
EMAIL_FROM=

# --- Premium billing ---
# disabled | sandbox | stripe | cashfree
# sandbox = local signed webhooks + fake checkout (no Stripe network)
# stripe  = requires STRIPE_* secrets below
# cashfree = requires CASHFREE_* secrets below (India PG)
BILLING_PROVIDER=sandbox

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SUCCESS_URL=http://localhost:5173/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/billing/cancel
# Optional replay window (seconds). Default 86400 (24h).
# STRIPE_WEBHOOK_MAX_AGE_SEC=86400

# --- Cashfree Payments (never commit real secrets) ---
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_ENV=sandbox
# CASHFREE_API_VERSION=2025-01-01
# CASHFREE_ENV=sandbox
# CASHFREE_ENVIRONMENT=SANDBOX
# Optional verbose create-order diagnostics (never logs secrets):
# DEBUG_CASHFREE=true
# CASHFREE_PREMIUM_AMOUNT=10
# CASHFREE_PREMIUM_CURRENCY=INR
# CASHFREE_PREMIUM_DAYS=30
# CASHFREE_SUCCESS_URL=http://localhost:5173/?billing=success&order_id={order_id}
# CASHFREE_CANCEL_URL=http://localhost:5173/?billing=cancel
# Webhook URL to register in Cashfree dashboard:
#   http://<your-host>/api/v1/auth/webhooks/cashfree

# --- Dev-only test users (never enable in production) ---
# ENABLE_TEST_USER_SEED=true
# TEST_PREMIUM_USER_PASSWORD=
# TEST_FREE_USER_PASSWORD=
# Optional: expose GET /api/v1/auth/admin/test-users (admin + ENABLE_TEST_USER_SEED)

