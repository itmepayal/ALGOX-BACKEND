  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT access token issued by AuthService."
      },
      "internalServiceSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-secret",
        "description": "Configured service-to-service secret."
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "description": "Standard response wrapper returned across AlgoPath REST endpoints.",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Operation completed successfully"
          },
          "data": {
            "description": "Payload data object or array."
          },
          "meta": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "success",
          "message"
        ],
        "additionalProperties": true
      },
      "Pagination": {
        "type": "object",
        "description": "Pagination metadata for list endpoints.",
        "properties": {
          "page": {
            "type": "integer",
            "example": 1
          },
          "limit": {
            "type": "integer",
            "example": 20
          },
          "total": {
            "type": "integer",
            "example": 100
          },
          "pages": {
            "type": "integer",
            "example": 5
          }
        },
        "required": [
          "page",
          "limit",
          "total",
          "pages"
        ]
      },
      "User": {
        "type": "object",
        "description": "AlgoPath user account domain entity.",
        "properties": {
          "_id": {
            "type": "string",
            "example": "650000000000000000000000"
          },
          "name": {
            "type": "string",
            "example": "Jane Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "jane@example.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin",
              "moderator"
            ],
            "example": "user"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended",
              "pending"
            ],
            "example": "active"
          },
          "avatar": {
            "type": "string",
            "example": "https://example.com/avatar.png"
          },
          "isEmailVerified": {
            "type": "boolean",
            "example": true
          },
          "twoFactorEnabled": {
            "type": "boolean",
            "example": false
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "_id",
          "name",
          "email",
          "role",
          "status"
        ]
      },
      "Problem": {
        "type": "object",
        "description": "AlgoPath coding problem entity.",
        "properties": {
          "_id": {
            "type": "string",
            "example": "650000000000000000000000"
          },
          "title": {
            "type": "string",
            "example": "Two Sum"
          },
          "slug": {
            "type": "string",
            "example": "two-sum"
          },
          "description": {
            "type": "string",
            "example": "Given an array of integers..."
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ],
            "example": "easy"
          },
          "category": {
            "type": "string",
            "example": "Arrays"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "array",
              "hash-table"
            ]
          },
          "isPremium": {
            "type": "boolean",
            "example": false
          },
          "timeLimitMs": {
            "type": "integer",
            "example": 2000
          },
          "memoryLimitMb": {
            "type": "integer",
            "example": 256
          }
        },
        "required": [
          "_id",
          "title",
          "slug",
          "difficulty",
          "category"
        ]
      },
      "Submission": {
        "type": "object",
        "description": "Code submission record entity.",
        "properties": {
          "_id": {
            "type": "string",
            "example": "650000000000000000000000"
          },
          "userId": {
            "type": "string",
            "example": "650000000000000000000000"
          },
          "problemId": {
            "type": "string",
            "example": "650000000000000000000000"
          },
          "language": {
            "type": "string",
            "enum": [
              "python",
              "javascript",
              "cpp",
              "java"
            ],
            "example": "python"
          },
          "code": {
            "type": "string",
            "example": "def twoSum(nums, target): return [0, 1]"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "RUNNING",
              "ACCEPTED",
              "WRONG_ANSWER",
              "TIME_LIMIT_EXCEEDED",
              "MEMORY_LIMIT_EXCEEDED",
              "RUNTIME_ERROR",
              "COMPILATION_ERROR"
            ],
            "example": "ACCEPTED"
          },
          "executionTime": {
            "type": "number",
            "example": 45
          },
          "memory": {
            "type": "number",
            "example": 14.2
          },
          "testCasesPassed": {
            "type": "integer",
            "example": 10
          },
          "totalTestCases": {
            "type": "integer",
            "example": 10
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "_id",
          "problemId",
          "language",
          "code",
          "status"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Standard error response payload.",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ],
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Validation or operation failure"
          },
          "code": {
            "type": "string",
            "example": "INVALID_INPUT"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "required": [
          "success",
          "message"
        ]
      }
    },
