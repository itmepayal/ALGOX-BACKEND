# RealtimeService — default port 3010
PORT=3010

# Same JWT_SECRET as AuthService / other microservices (required in production; no dev defaults)
JWT_SECRET=super_secret_jwt_access_key

# Shared S2S secret — MUST match Auth and all product services (required in production)
INTERNAL_SERVICE_SECRET=dev-internal-service-secret

# BroadcastLog Mongo URI (dedicated DB recommended, e.g. .../leetcode_realtime).
# Local: optional — empty disables durable logs (memory fallback; health reports mode=memory).
# Production: REQUIRED unless ALLOW_MEMORY_BROADCAST_LOGS=true (explicit non-durable opt-in).
MONGO_URL=

# Explicit production opt-in to memory-only BroadcastLog (not recommended).
# ALLOW_MEMORY_BROADCAST_LOGS=true

# Optional — Socket.IO Redis adapter for multi-instance fan-out.
# If unset or ioredis fails, degrades to in-memory (single process).
REDIS_URL=

# AuthService base URL for admin audit forwarding (no trailing slash)
AUTH_SERVICE_URL=http://localhost:3001/api/v1

# CORS origins (comma-separated explicit URLs). Never use *.
# Production requires at least one of: ALLOWED_ORIGINS, CLIENT_URL, or CORS_ORIGIN.
CORS_ORIGIN=http://localhost:5173

# Event stream ring buffer size
EVENT_BUFFER_SIZE=500

# Idle timeout (ms) before presence flips ONLINE → IDLE
IDLE_TIMEOUT_MS=120000

# Production checklist:
# NODE_ENV=production
# JWT_SECRET=<unique non-default>
# INTERNAL_SERVICE_SECRET=<unique, identical across all services>
# MONGO_URL=mongodb+srv://.../leetcode_realtime
# CORS_ORIGIN=https://your-frontend.example
