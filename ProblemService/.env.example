# ProblemService — copy to .env and fill values. Never commit real secrets.

PORT=3003
MONGO_URL=mongodb://127.0.0.1:27017/algopath_problems
JWT_SECRET=change-me-in-production
SUBMISSION_SERVICE_URL=http://localhost:3004
AUTH_SERVICE_URL=http://localhost:3001
LEADERBOARD_SERVICE_URL=http://localhost:3005/api/v1
INTERNAL_SERVICE_SECRET=change-me-in-production
NODE_ENV=development

# AlgoPath AI (server-side only — never expose to the client)
# Default provider is Gemini. Set AI_PROVIDER=openai to use OpenAI instead.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Optional OpenAI rollback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Daily quotas (server-enforced). Free quota is ignored — AI is Premium-only.
AI_FREE_DAILY_QUOTA=0
AI_PREMIUM_DAILY_QUOTA=100
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=60000
